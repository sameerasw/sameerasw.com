{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sameerasw-com",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"run_worker_first": [
      "/unsplash-today.json",
      "/photos.json",
      "/project-details.json",
      "/github-stats.json",
      "/essentials-contributors.json",
      "/essentials-update.json",
      "/api/*",
      "/.netlify/*"
    ],
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"kv_namespaces": [
		{
			"binding": "DATA",
			"id": "dd5546c52bb44f37a5622d75ec6f8862"
		}
	]
}